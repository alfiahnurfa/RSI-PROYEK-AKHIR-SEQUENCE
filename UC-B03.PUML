@startuml SD-UC-B03_MemfilterProduk
title Sequence Diagram UC-B03: Memfilter Produk Berdasarkan Kriteria
skinparam style strictuml

actor Pembeli
boundary HalamanKatalog
control ProdukController
entity Produk

activate Pembeli
Pembeli -> HalamanKatalog : Akses halaman katalog
activate HalamanKatalog

Pembeli -> HalamanKatalog : Pilih filter (kategori/harga/sort)

HalamanKatalog -> ProdukController : filter(filterCriteria: FilterCriteria)
activate ProdukController

ProdukController -> Produk : filterByCriteria(filterCriteria.data)
activate Produk
Produk --> ProdukController : FilteredProductList: List<Produk>
deactivate Produk

ProdukController --> HalamanKatalog : FilteredProductList
deactivate ProdukController

HalamanKatalog -> Pembeli : Tampilkan produk yang tersaring
deactivate HalamanKatalog
deactivate Pembeli

@enduml