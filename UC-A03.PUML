@startuml SD-UC-A03_UpdateProfil
title Sequence Diagram UC-A03: Memperbarui Data Profil
skinparam style strictuml

actor Pengguna
boundary HalamanProfil
control UserController
entity User

activate Pengguna
Pengguna -> HalamanProfil : Mengakses halaman profil
activate HalamanProfil
HalamanProfil -> UserController : getAuthenticatedUser()
activate UserController
UserController -> User : findById(auth_id: integer)
activate User
User --> UserController : UserData: User
deactivate User
UserController --> HalamanProfil : displayProfile(UserData)
deactivate UserController

Pengguna -> HalamanProfil : Input(UpdateData)

Pengguna -> HalamanProfil : Klik "Simpan Profil"

HalamanProfil -> UserController : updateProfile(request: UpdateRequest)
activate UserController

UserController -> User : validate(request.data)
activate User
UserController -> User : update(auth_id, request.data)

User --> UserController : UpdatedUser: User
deactivate User
    
UserController --> HalamanProfil : responseSuccess(UpdatedUser)
deactivate UserController
    
HalamanProfil -> Pengguna : Tampilkan profil terbaru
deactivate HalamanProfil
deactivate Pengguna

@enduml