@startuml SD-UC-K02_TambahBerita
title Sequence Diagram UC-K02: Menambahkan Berita Baru (Admin)
skinparam style strictuml

actor Admin
boundary HalamanDaftarBerita
boundary HalamanFormBerita
control BeritaController
entity Berita

activate Admin
Admin -> HalamanDaftarBerita : Mengakses halaman daftar berita
activate HalamanDaftarBerita

Admin -> HalamanDaftarBerita : Klik "Tambah Berita"
deactivate HalamanDaftarBerita

HalamanFormBerita -> Admin : Tampilkan formulir penambahan berita
activate HalamanFormBerita

Admin -> HalamanFormBerita : Mengisi informasi berita

Admin -> HalamanFormBerita : Klik "Terbitkan"

HalamanFormBerita -> BeritaController : POST /admin/berita (request: object)
activate BeritaController

BeritaController -> Berita : validate(request.data)
activate Berita

BeritaController -> Berita : create(request.data, status: 'Terbit')
Berita --> BeritaController : NewBerita: Berita
deactivate Berita
    
BeritaController --> HalamanFormBerita : responseSuccess(message: string)
deactivate BeritaController
    
HalamanFormBerita -> Admin : Tampilkan notifikasi sukses dan redirect
deactivate HalamanFormBerita
deactivate Admin

@enduml