@startuml SD-UC-K02_TambahBerita
title Sequence Diagram UC-K02: Menambahkan Berita (Admin)
skinparam style strictuml

actor Admin
boundary HalamanKelolaBerita
boundary HalamanTambahBerita
control TambahBeritaController
entity Berita
database beritas

activate Admin

Admin -> HalamanTambahBerita : Klik "Tambahkan"
activate HalamanTambahBerita

HalamanTambahBerita -> TambahBeritaController : tambahBerita(request: Request)
activate TambahBeritaController

TambahBeritaController -> TambahBeritaController : validate($request: Request)
TambahBeritaController -> Berita : Berita::create(data: Array)
activate Berita

Berita -> beritas : INSERT INTO beritas ...
activate beritas

beritas --> Berita : return(berita: Berita)
deactivate beritas

Berita --> TambahBeritaController : return(berita: Berita)
deactivate Berita

TambahBeritaController --> HalamanTambahBerita : response(data: Array)
deactivate TambahBeritaController

HalamanTambahBerita -> HalamanKelolaBerita : navigateTo('/admin/berita')
deactivate HalamanTambahBerita
activate HalamanKelolaBerita

HalamanKelolaBerita -> Admin : Tampilkan daftar berita
deactivate HalamanKelolaBerita
deactivate Admin

@enduml