@startuml SD-UC-A04_UbahKataSandi
title Sequence Diagram UC-A04: Mengubah Kata Sandi Akun
skinparam style strictuml

actor Pengguna
boundary HalamanProfil
control UserController
entity User

activate Pengguna
Pengguna -> HalamanProfil : Mengakses halaman profil
activate HalamanProfil

Pengguna -> HalamanProfil : Klik "Ubah Kata Sandi"
HalamanProfil -> Pengguna : Tampilkan formulir perubahan sandi

Pengguna -> HalamanProfil : Input(old_password, new_password, confirmation)

Pengguna -> HalamanProfil : Klik "Simpan Kata Sandi"

HalamanProfil -> UserController : changePassword(request: ChangePasswordRequest)
activate UserController

UserController -> User : validate(request.data)
activate User
UserController -> User : findById(auth_id)

User --> UserController : UserData: User
deactivate User

UserController -> User : verifyAndHash(old_password, new_password, UserData.hash)
activate User
UserController -> User : updatePassword(auth_id, new_password_hash)

User --> UserController : Status Update: boolean
deactivate User

UserController --> HalamanProfil : responseSuccess("Kata Sandi Berhasil Diperbarui")
deactivate UserController

HalamanProfil -> Pengguna : Notifikasi sukses
deactivate HalamanProfil
deactivate Pengguna

@enduml