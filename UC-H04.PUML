@startuml SD-UC-H04_MengarsipkanProduk
title Sequence Diagram UC-H04: Mengarsipkan Produk
skinparam style strictuml

actor Admin
boundary HalamanKelolaProduk
control ProdukController
entity Produk

activate Admin
Admin -> HalamanKelolaProduk : Mengakses halaman "/admin/produk"
activate HalamanKelolaProduk

HalamanKelolaProduk -> Admin : Tampilkan daftar seluruh produk

Admin -> HalamanKelolaProduk : Klik "Arsipkan" (ID_Produk: integer)

HalamanKelolaProduk -> ProdukController : PATCH /admin/produk/{ID_Produk} (request: {status: 'Arsip'})
activate ProdukController

ProdukController -> Produk : updateStatus(ID_Produk, 'Arsip')
activate Produk
Produk --> ProdukController : updateStatus: boolean
deactivate Produk

ProdukController --> HalamanKelolaProduk : responseSuccess(message: string)
deactivate ProdukController

HalamanKelolaProduk -> Admin : Tampilkan notifikasi sukses dan daftar terbaru
deactivate HalamanKelolaProduk
deactivate Admin

@enduml