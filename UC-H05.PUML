@startuml SD-UC-H05_PerbaruiStok
title Sequence Diagram UC-H05: Memperbarui Stok Produk
skinparam style strictuml

actor Admin
boundary HalamanKelolaProduk
control ProdukController
entity Produk

activate Admin
Admin -> HalamanKelolaProduk : Mengakses halaman "/admin/produk"
activate HalamanKelolaProduk

HalamanKelolaProduk -> Admin : Tampilkan daftar produk beserta field stok

Admin -> HalamanKelolaProduk : Edit nilai stok baru

HalamanKelolaProduk -> ProdukController : PATCH /admin/produk/{ID_Produk} (request: {stok: integer})
activate ProdukController

ProdukController -> Produk : validate(request.data)
activate Produk

ProdukController -> Produk : updateStock(ID_Produk, New_Stock_Value)
Produk --> ProdukController : updateStatus: boolean
deactivate Produk

ProdukController --> HalamanKelolaProduk : responseSuccess(message: string)
deactivate ProdukController

HalamanKelolaProduk -> Admin : Tampilkan notifikasi sukses dan nilai stok terbaru
deactivate HalamanKelolaProduk
deactivate Admin

@enduml