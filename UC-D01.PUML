@startuml SD-UC-D01_MelakukanProsesPemesanan
title Sequence Diagram UC-D01: Melakukan Proses Pemesanan
skinparam style strictuml

actor Pembeli
boundary HalamanCheckout
control PesananController
entity Pesanan
entity DetailPesanan
entity Pembayaran

activate Pembeli
Pembeli -> HalamanCheckout : Mengakses halaman Checkout
activate HalamanCheckout

HalamanCheckout -> PesananController : GET /checkout (auth_id)
activate PesananController
PesananController -> DetailPesanan : getCartItems(auth_id)
activate DetailPesanan
DetailPesanan --> PesananController : CartData: object
deactivate DetailPesanan

PesananController --> HalamanCheckout : displayCheckoutForm(CartData)
deactivate PesananController

Pembeli -> HalamanCheckout : Konfirmasi Alamat & Pilih Metode Bayar
Pembeli -> HalamanCheckout : Klik "Beli Sekarang"

HalamanCheckout -> PesananController : POST /pesanan (request: CheckoutRequest)
activate PesananController

PesananController -> Pesanan : validate(request.data)
activate Pesanan

PesananController -> Pesanan : createOrder(request.data, auth_id)
Pesanan -> DetailPesanan : finalizeItems(auth_id)
activate DetailPesanan
Pesanan -> DetailPesanan : calculateTotal()
deactivate DetailPesanan
Pesanan -> Pembayaran : createPaymentRecord()
activate Pembayaran
Pembayaran --> Pesanan : PaymentData: object
deactivate Pembayaran
Pesanan --> PesananController : NewOrderID: integer
deactivate Pesanan

PesananController --> HalamanCheckout : responseSuccess(NewOrderID)
deactivate PesananController

HalamanCheckout -> Pembeli : Redirect ke /dashboard/transaksi/{NewOrderID}
deactivate HalamanCheckout
deactivate Pembeli

@enduml