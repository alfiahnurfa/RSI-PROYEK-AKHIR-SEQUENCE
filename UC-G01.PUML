@startuml SD-UC-G01_MembacaBerita
title Sequence Diagram UC-G01: Membaca Berita
skinparam style strictuml

actor Pembeli
boundary HalamanDaftarBerita
boundary HalamanDetailBerita
control LihatBeritaController
entity Berita

activate Pembeli

Pembeli -> HalamanDaftarBerita : Mengakses '/berita'
activate HalamanDaftarBerita

HalamanDaftarBerita -> LihatBeritaController : ambilDaftarBerita()
activate LihatBeritaController

LihatBeritaController -> Berita : Berita::where(status='published')
activate Berita

Berita --> LihatBeritaController : return(berita: Array)
deactivate Berita

LihatBeritaController --> HalamanDaftarBerita : response(berita: Array)
deactivate LihatBeritaController

HalamanDaftarBerita -> Pembeli : Tampilkan daftar berita

Pembeli -> HalamanDaftarBerita : Klik card berita

HalamanDaftarBerita -> HalamanDetailBerita : navigateTo('/berita/{id_berita}')
deactivate HalamanDaftarBerita
activate HalamanDetailBerita

HalamanDetailBerita -> LihatBeritaController : ambilDetailBerita($id: int)
activate LihatBeritaController

LihatBeritaController -> Berita : Berita::where($id_berita, first())
activate Berita

Berita --> LihatBeritaController : return(berita: Berita)
deactivate Berita

LihatBeritaController --> HalamanDetailBerita : response(berita: Berita)
deactivate LihatBeritaController

HalamanDetailBerita -> Pembeli : Tampilkan detail berita
deactivate HalamanDetailBerita

@enduml