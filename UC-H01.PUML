@startuml SD-UC-H01_MelihatDaftarProdukAdmin
title Sequence Diagram UC-H01: Melihat Daftar Produk (Admin)
skinparam style strictuml

actor Admin
boundary HalamanKelolaProduk
control ProdukController
entity Produk

activate Admin
Admin -> HalamanKelolaProduk : Mengakses halaman "/admin/produk"
activate HalamanKelolaProduk

HalamanKelolaProduk -> ProdukController : GET /admin/produk
activate ProdukController

ProdukController -> Produk : findAll()
activate Produk
Produk --> ProdukController : ProductList: List<Produk>
deactivate Produk

ProdukController --> HalamanKelolaProduk : response(ProductList)
deactivate ProdukController

HalamanKelolaProduk -> Admin : Tampilkan daftar produk dan opsi aksi
deactivate HalamanKelolaProduk
deactivate Admin

@enduml